IDENTITY_ENVIRONMENT=local
IDENTITY_DATABASE_URL=postgresql+asyncpg://identity_service:identity-local-only@localhost:5432/identity_service
IDENTITY_JWT_SECRET=replace-with-at-least-32-random-bytes
IDENTITY_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
IDENTITY_KAFKA_TOPIC=fastapi-platform.identity.events.v1
IDENTITY_KAFKA_PUBLISHER_ENABLED=false
IDENTITY_OUTBOX_POLL_INTERVAL_SECONDS=1
IDENTITY_OTP_REDIS_URL=redis://localhost:6379/1
IDENTITY_OTP_CODE_TTL_SECONDS=300
IDENTITY_OTP_RESEND_COOLDOWN_SECONDS=60
IDENTITY_OTP_MAX_VERIFY_ATTEMPTS=5
IDENTITY_OTP_PHONE_RATE_LIMIT=5
IDENTITY_OTP_PHONE_RATE_WINDOW_SECONDS=3600
IDENTITY_OTP_NOTIFICATION_BASE_URL=http://notification-service:8000
IDENTITY_OTP_NOTIFICATION_TIMEOUT_SECONDS=5
IDENTITY_INTERNAL_OTP_SHARED_SECRET=
