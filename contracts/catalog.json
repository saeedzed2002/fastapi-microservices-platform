{
  "catalog_schema": "catalog.schema.json",
  "catalog_version": 1,
  "project": "FastAPI Microservices Platform",
  "namespace": "fastapi-platform",
  "contracts": [
    {
      "name": "identity.user_registered.v1",
      "kind": "domain-event",
      "owner": "identity-service",
      "consumers": ["customer-service"],
      "status": "deprecated",
      "topic": "fastapi-platform.identity.events.v1",
      "message_key": "aggregate_id",
      "notes": "Customer creates its own profile projection from this durable identity fact.",
      "schema": "events/identity.user_registered.v1.schema.json"
    },
    {
      "name": "identity.user_registered.v2",
      "kind": "domain-event",
      "owner": "identity-service",
      "consumers": ["customer-service"],
      "status": "active",
      "topic": "fastapi-platform.identity.events.v1",
      "message_key": "aggregate_id",
      "notes": "Phone-only customer registration after successful OTP verification. Raw OTP values never enter Kafka.",
      "schema": "events/identity.user_registered.v2.schema.json"
    },
    {
      "name": "identity.auth.v1",
      "kind": "service-openapi",
      "owner": "identity-service",
      "status": "active",
      "notes": "Public customer OTP and staff password authentication endpoints. Internal OTP delivery retrieval is intentionally excluded.",
      "schema": "openapi/identity-auth.v1.openapi.json"
    },
    {
      "name": "identity.admin.v1",
      "kind": "service-openapi",
      "owner": "identity-service",
      "status": "active",
      "notes": "Administrator-only support-agent lifecycle API. The first administrator remains an interactive CLI bootstrap operation.",
      "schema": "openapi/identity-admin.v1.openapi.json"
    },
    {
      "name": "customer.profile.v1",
      "kind": "service-openapi",
      "owner": "customer-service",
      "status": "active",
      "notes": "Customer-owned contact profile API. The contact email is not an Identity credential and is required for checkout invoice email.",
      "schema": "openapi/customer-profile.v1.openapi.json"
    },
    {
      "name": "order.query.v1",
      "kind": "service-openapi",
      "owner": "order-service",
      "status": "active",
      "notes": "Customer-owned order history and administrator-only read-only operational review APIs.",
      "schema": "openapi/order-query.v1.openapi.json"
    },
    {
      "name": "order.checkout.v1",
      "kind": "service-openapi",
      "owner": "order-service",
      "status": "active",
      "notes": "Customer checkout commands, including the Cart-backed one-step Zarinpal redirect path.",
      "schema": "openapi/order-checkout.v1.openapi.json"
    },
    {
      "name": "payment.zarinpal.v1",
      "kind": "service-openapi",
      "owner": "payment-service",
      "status": "active",
      "notes": "Customer payment-start API and verified Zarinpal browser-return callback. Existing payment Saga events remain unchanged.",
      "schema": "openapi/payment-zarinpal.v1.openapi.json"
    },
    {
      "name": "event-envelope.v1",
      "kind": "event-envelope",
      "owner": "platform",
      "status": "active",
      "schema": "events/event-envelope.v1.schema.json"
    },
    {
      "name": "kafka.dead_letter.v1",
      "kind": "dead-letter-envelope",
      "owner": "platform",
      "status": "active",
      "topic": "fastapi-platform.dead-letter.v1",
      "message_key": "source.topic:source.partition:source.offset",
      "notes": "Technical Kafka processing failures only. The original record is preserved as base64 bytes together with source coordinates and local retry history.",
      "schema": "events/kafka.dead_letter.v1.schema.json"
    },
    {
      "name": "error-response.v1",
      "kind": "api-error-envelope",
      "owner": "platform",
      "status": "active",
      "schema": "openapi/error-response.v1.schema.json"
    },
    {
      "name": "chat.v1",
      "kind": "realtime-client-protocol",
      "owner": "chat-service",
      "status": "active",
      "notes": "Bidirectional WebSocket client protocol. Sender acknowledgements follow the local Chat PostgreSQL commit; messages may be duplicated across reconnect or Redis fan-out and are deduplicated by message_id.",
      "schema": "realtime/chat.v1.schema.json"
    },
    {
      "name": "chat.support.v1",
      "kind": "service-openapi",
      "owner": "chat-service",
      "status": "active",
      "notes": "Customer support queue creation, metadata-only agent queue listing, atomic claim, release, and close operations. The assigned agent becomes the only agent participant.",
      "schema": "openapi/chat-support.v1.openapi.json"
    },
    {
      "name": "order.created.v1",
      "kind": "domain-event",
      "owner": "order-service",
      "consumers": ["inventory-service"],
      "status": "active",
      "topic": "fastapi-platform.order.events.v1",
      "message_key": "order_id",
      "notes": "Checkout workflow key is order_id.",
      "schema": "events/order.created.v1.schema.json"
    },
    {
      "name": "inventory.reserved.v1",
      "kind": "domain-event",
      "owner": "inventory-service",
      "consumers": ["order-service", "payment-service"],
      "status": "active",
      "topic": "fastapi-platform.inventory.events.v1",
      "message_key": "order_id",
      "notes": "Checkout workflow key is order_id.",
      "schema": "events/inventory.reserved.v1.schema.json"
    },
    {
      "name": "inventory.reservation_failed.v1",
      "kind": "domain-event",
      "owner": "inventory-service",
      "consumers": ["order-service"],
      "status": "active",
      "topic": "fastapi-platform.inventory.events.v1",
      "message_key": "order_id",
      "notes": "Checkout workflow key is order_id.",
      "schema": "events/inventory.reservation_failed.v1.schema.json"
    },
    {
      "name": "payment.processing.v1",
      "kind": "domain-event",
      "owner": "payment-service",
      "consumers": ["order-service"],
      "status": "active",
      "topic": "fastapi-platform.payment.events.v1",
      "message_key": "order_id",
      "notes": "Payment accepted the reservation and opened its local payment workflow.",
      "schema": "events/payment.processing.v1.schema.json"
    },
    {
      "name": "payment.succeeded.v1",
      "kind": "domain-event",
      "owner": "payment-service",
      "consumers": ["order-service"],
      "status": "active",
      "topic": "fastapi-platform.payment.events.v1",
      "message_key": "order_id",
      "notes": "Checkout workflow key is order_id.",
      "schema": "events/payment.succeeded.v1.schema.json"
    },
    {
      "name": "payment.failed.v1",
      "kind": "domain-event",
      "owner": "payment-service",
      "consumers": ["order-service", "inventory-service"],
      "status": "active",
      "topic": "fastapi-platform.payment.events.v1",
      "message_key": "order_id",
      "notes": "Checkout workflow key is order_id.",
      "schema": "events/payment.failed.v1.schema.json"
    },
    {
      "name": "order.confirmed.v1",
      "kind": "domain-event",
      "owner": "order-service",
      "consumers": ["order-service"],
      "status": "active",
      "topic": "fastapi-platform.order.events.v1",
      "message_key": "order_id",
      "notes": "Order is terminally confirmed. An independent Order consumer group creates the durable invoice-generation handoff.",
      "schema": "events/order.confirmed.v1.schema.json"
    },
    {
      "name": "invoice.generated.v1",
      "kind": "domain-event",
      "owner": "order-service",
      "consumers": ["notification-service"],
      "status": "active",
      "topic": "fastapi-platform.order.events.v1",
      "message_key": "order_id",
      "notes": "Invoice bytes remain Order-owned object storage data; Notification receives only the delivery fact and recipient contact snapshot.",
      "schema": "events/invoice.generated.v1.schema.json"
    },
    {
      "name": "media.ready.v1",
      "kind": "domain-event",
      "owner": "media-service",
      "consumers": [],
      "status": "active",
      "topic": "fastapi-platform.media.events.v1",
      "message_key": "aggregate_id",
      "schema": "events/media.ready.v1.schema.json"
    },
    {
      "name": "product.created.v1",
      "kind": "domain-event",
      "owner": "catalog-service",
      "consumers": ["search-service"],
      "status": "reserved",
      "topic": "fastapi-platform.catalog.events.v1",
      "message_key": "aggregate_id",
      "schema": null
    },
    {
      "name": "product.updated.v1",
      "kind": "domain-event",
      "owner": "catalog-service",
      "consumers": ["search-service"],
      "status": "reserved",
      "topic": "fastapi-platform.catalog.events.v1",
      "message_key": "aggregate_id",
      "schema": null
    },
    {
      "name": "product.deleted.v1",
      "kind": "domain-event",
      "owner": "catalog-service",
      "consumers": ["search-service"],
      "status": "reserved",
      "topic": "fastapi-platform.catalog.events.v1",
      "message_key": "aggregate_id",
      "schema": null
    }
  ]
}
