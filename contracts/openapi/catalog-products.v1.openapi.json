{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalog Product Query API",
    "version": "v1",
    "description": "Public, cursor-paginated listing of published Catalog products. media_urls contains same-origin public Media redirect paths in the same order as media_asset_ids."
  },
  "paths": {
    "/api/v1/catalog/products": {
      "get": {
        "summary": "List published products in descending publication order",
        "parameters": [
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}},
          {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 256}}
        ],
        "responses": {
          "200": {
            "description": "Published product page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items", "next_cursor"],
                  "properties": {
                    "items": {"type": "array", "items": {"$ref": "#/components/schemas/Product"}},
                    "next_cursor": {"type": ["string", "null"]}
                  }
                }
              }
            }
          },
          "422": {"description": "Invalid pagination cursor"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": ["id", "name", "slug", "description", "status", "price_amount", "currency", "attributes", "media_asset_ids", "media_urls", "created_at", "updated_at", "published_at", "archived_at"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "slug": {"type": "string"},
          "description": {"type": "string"},
          "status": {"const": "published"},
          "brand_id": {"type": ["string", "null"], "format": "uuid"},
          "category_id": {"type": ["string", "null"], "format": "uuid"},
          "price_amount": {"type": "string"},
          "currency": {"type": "string"},
          "attributes": {"type": "object", "additionalProperties": {"type": "string"}},
          "media_asset_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
          "media_urls": {"type": "array", "items": {"type": "string", "format": "uri-reference"}},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"},
          "published_at": {"type": "string", "format": "date-time"},
          "archived_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
