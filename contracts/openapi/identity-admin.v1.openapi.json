{
  "openapi": "3.1.0",
  "info": {
    "title": "Identity Staff Administration API",
    "version": "v1",
    "description": "Only an active admin may provision or manage support-agent accounts. The initial admin is created by the non-public Identity CLI."
  },
  "paths": {
    "/api/v1/admin/support-agents": {
      "get": {
        "summary": "List support-agent accounts",
        "security": [{"bearerAuth": []}],
        "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}],
        "responses": {"200": {"description": "Support agents"}, "401": {"description": "Inactive administrator"}, "403": {"description": "Administrator role required"}}
      },
      "post": {
        "summary": "Provision one support-agent account",
        "security": [{"bearerAuth": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupportAgentCreate"}}}},
        "responses": {"201": {"description": "Support agent provisioned", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupportAgent"}}}}, "409": {"description": "Identity email already exists"}}
      }
    },
    "/api/v1/admin/support-agents/{support_agent_id}": {
      "patch": {
        "summary": "Activate or suspend one support agent",
        "security": [{"bearerAuth": []}],
        "parameters": [{"name": "support_agent_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupportAgentStatusUpdate"}}}},
        "responses": {"200": {"description": "Support agent updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupportAgent"}}}}, "404": {"description": "Support agent not found"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "schemas": {
      "SupportAgentCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {"email": {"type": "string", "format": "email"}, "password": {"type": "string", "minLength": 12, "maxLength": 128}}
      },
      "SupportAgentStatusUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {"status": {"enum": ["active", "suspended"]}}
      },
      "SupportAgent": {
        "type": "object",
        "required": ["id", "email", "status", "roles", "created_at", "updated_at"],
        "properties": {"id": {"type": "string", "format": "uuid"}, "email": {"type": "string", "format": "email"}, "status": {"enum": ["active", "suspended"]}, "roles": {"type": "array", "items": {"type": "string"}}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}
      }
    }
  }
}
