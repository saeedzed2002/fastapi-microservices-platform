{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastapi-platform.local/contracts/events/identity.user_registered.v1.schema.json",
  "title": "Identity user registered event payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_id", "email", "roles"],
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 320
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true
    }
  }
}
