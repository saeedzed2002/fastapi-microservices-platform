{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fastapi-platform:contracts:events:event-envelope:v1",
  "title": "FastAPI Platform Event Envelope v1",
  "description": "Canonical envelope for versioned Kafka domain events.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "aggregate_type",
    "aggregate_id",
    "producer",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "trace_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*\\.v[1-9][0-9]*$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-service$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "causation_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
