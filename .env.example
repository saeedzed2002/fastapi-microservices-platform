# Local-only values. Copy this file to .env and keep the copy out of Git.
# Allows `docker compose ...` from the repository root without an explicit -f flag.
COMPOSE_FILE=infrastructure/compose/docker-compose.yml
PLATFORM_INTERNAL_OTP_SHARED_SECRET=<random-secret-with-at-least-32-characters>
NOTIFICATION_SMSIR_ENABLED=false
NOTIFICATION_SMSIR_API_KEY=<your-api-key>
NOTIFICATION_SMSIR_LINE_NUMBER=<your-services-line-number>
IDENTITY_STAFF_LOGIN_MAX_FAILURES=5
IDENTITY_STAFF_LOGIN_FAILURE_WINDOW_SECONDS=900
IDENTITY_STAFF_LOGIN_LOCKOUT_SECONDS=900
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=https://localhost/api/v1/payments/zarinpal/callback
ZARINPAL_REQUEST_TIMEOUT_SECONDS=10
PAYMENT_RESERVATION_MINUTES=15
